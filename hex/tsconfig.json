{
	"compilerOptions": {
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["es2022"],
		"types": [],
		"strict": true,
		"noEmitOnError": true,
		"outDir": "dist",
		"rootDir": ".",
		"skipLibCheck": true
	},
	"include": ["./*.ts", "vendor-ref/**/*.ts"],
	"exclude": ["dist", "demo", "tests", "tools"]
}
