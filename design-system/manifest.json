  "components": [
    {
      "name": "TreeOfLife",
      "group": "the tree of life",
      "summary": "austras koks — the latvian tree of life, drawn with the house crest's own branch — carrying a family line: 2 parents, 4 grandparents, 8, 16. one set of generat…"
    },
    {
      "name": "RegisterToggle",
      "group": "registers",
      "summary": "the one control that changes how a page speaks: new bee · raver · cypherpunk, as three named pills with their marks, the pressed one filled with register-on."
    },
    {
      "name": "Wordmark",
      "group": "registers",
      "summary": "sets a name exactly as the founder cases it — capitals heavy, small letters light — in the house hand, burti."
    },
    {
      "name": "Sign",
      "group": "the tree of life",
      "summary": "the house's latvian signs, copied path for path from the crest: austras-koks, saule, auseklis, jumis, mara-cross, mara-water, cell, heart."
    },
    {
      "name": "Button",
      "group": "actions",
      "summary": "three weights of press: primary is the one thing the view is for, outline is the other real choice, quiet is an action at the weight of a link."
    },
    {
      "name": "ConsentCheck",
      "group": "actions",
      "summary": "the line a person ticks before a primary that cannot be undone: \"i understand, and i choose this.\""
    },
    {
      "name": "ListCard",
      "group": "rows",
      "summary": "a card of rows: a thing on the left, its state on the right."
    },
    {
      "name": "PersonRow",
      "group": "rows",
      "summary": "one ancestor: initials on a sovereign-wash disc, the name with its capitals, and how many sources stand behind it."
    },
    {
      "name": "PlainRow",
      "group": "rows",
      "summary": "what cannot happen yet, said as a row of prose with its reason in sight. never a disabled button."
    },
    {
      "name": "GuardRow",
      "group": "laws",
      "summary": "the living guard, in guard lilac: the system declined, and nothing broke."
    },
    {
      "name": "StatusChip",
      "group": "status",
      "summary": "a word and a mark, then a colour: verified (settled, current), human (a family draft), guard (held out)."
    },
    {
      "name": "Asking",
      "group": "status",
      "summary": "the honest waiting state: what is being asked, the seconds so far, and a way to stop."
    },
    {
      "name": "BChip",
      "group": "status",
      "summary": "a b amount: honey on the dark chip. the only place b-value is ever used."
    },
    {
      "name": "Icon",
      "group": "marks",
      "summary": "the ten 16px stroke marks, copied from the graded canvas: bee (the cell), raver (the burst), cypherpunk (the brackets), lock, eye, forever, no-undo, check, che…"
    }
  ],
