# Rebuild the exact deployed storage releases from their upstream source tags.
FROM golang:1.26-bookworm@sha256:a688600ca24f8a4d3ca77f95b0dd40704a9fc787c826660eb7ba0b641b8b175d AS builder
ENV GOMAXPROCS=2 GOFLAGS=-p=2 CGO_ENABLED=0
RUN git clone --depth 1 --branch RELEASE.2025-09-07T16-13-09Z https://github.com/minio/minio.git /src/minio \
 && git clone --depth 1 --branch RELEASE.2025-08-13T08-35-41Z https://github.com/minio/mc.git /src/mc \
 && test "$(git -C /src/minio rev-parse HEAD)" = 07c3a429bfed433e49018cb0f78a52145d4bedeb \
 && test "$(git -C /src/mc rev-parse HEAD)" = 7394ce0dd2a80935aded936b09fa12cbb3cb8096
WORKDIR /src/minio
RUN go build -trimpath -ldflags "$(go run buildscripts/gen-ldflags.go)" -o /out/minio .
WORKDIR /src/mc
RUN go build -trimpath -o /out/mc .

FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251 AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/minio /usr/bin/minio
COPY --from=builder /out/mc /usr/bin/mc
ENTRYPOINT ["/usr/bin/minio"]
