# keys.skaists.dev: the keychain edge (keychain release + edge contract, 2026-10-12, §4 and §6).
# Append this block, as is, to /opt/buzz/deploy/compose/Caddyfile.hostinger
# (procedure: ops/keys-edge/README.md). TLS 1.3 with the hybrid group X25519MLKEM768 only; the
# certificate stays classical P-256. keys-door is reached on keys-net by its fixed address, never
# by a container name. No import of the shared snippets and no log directive.
# No Caddy docs URL is cited: none was read for this block. The CI lab (lab/lab.sh) validates it
# with caddy 2.11.4 and probes what it does.
keys.skaists.dev {
  tls {
    protocols tls1.3
    curves x25519mlkem768
    key_type p256
  }
  @misdirected expression `{http.request.tls.server_name} != "keys.skaists.dev"`
  @notRead not method GET HEAD
  route {
    respond @misdirected 421 {
      close
    }
    respond @notRead 405
    header {
      -Server
      -Alt-Svc
      Strict-Transport-Security "max-age=63072000"
      X-Content-Type-Options nosniff
      Referrer-Policy no-referrer
    }
    reverse_proxy 10.80.96.2:8096
  }
}
