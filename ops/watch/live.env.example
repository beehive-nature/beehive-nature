# live.env — template for /etc/buzz-watch/live.env on the box (600, root).
# STREAM_KEY: generate on the box, e.g.
#   openssl rand -hex 24
# Never commit the real one; this template is the shape only.
STREAM_KEY=__generate_on_the_box_openssl_rand_hex_24__
RPC=https://jungle4.greymass.com
CONTRACT=bnrapolltest
LIVE_DIR=/opt/buzz/deploy/compose/live
PORT=8094
RTMP_PORT=1935
ROOM=general
