# BNR ar-io-node env — NO-TOKEN, NO-STAKING mode (PHASE0_AR_ANT_SETUP_SPEC step 2).
# Copied to /var/lib/bnr/ar-io-node/.env at deploy; consumed by UPSTREAM's
# docker-compose.yaml unmodified. Var names verified at source against
# ar-io/ar-io-node .env.example + docker-compose.yaml (2026-08-10).
#
# NO-TOKEN MODE: AR_IO_WALLET deliberately ABSENT (compose defaults it empty).
# No wallet, no staking, no ARIO token participation — a pure read gateway.

# Sync from a recent height, not genesis: a Phase-0 gateway serves fresh reads;
# deep history stays proxied to the trusted node until a full backfill is chosen.
# DEPLOY-TIME: set to (current block height - ~50k) at deploy.
START_HEIGHT=1520000

# Upstream data source while our index backfills.
TRUSTED_NODE_URL=https://arweave.net
TRUSTED_GATEWAY_URL=https://arweave.net

# Ports (upstream defaults, pinned explicitly): envoy = public edge, core = GraphQL.
ENVOY_PORT=3000
CORE_PORT=4000

# ANS-104 unbundling ON so our own GraphQL can index DataItems (incl. our
# Ed25519 sig-type-2 items) without asking arweave.net.
ANS104_UNBUNDLE_FILTER={"always": true}
ANS104_INDEX_FILTER={"always": true}

LOG_FORMAT=simple
