// SPEC-BTUNGSTEN-PQ-1 PQ02 — TOOTH for the loop proof (keccak 0.2.2): agree
// against composed_swapped, the round bodies with rounds 5 and 6 swapped
// (RC[5] != RC[6]), on the all-zero state. It MUST fail with a counterexample,
// or the agree PROVEN line could not tell round orders apart. One state is
// enough to show that; a symbolic state, even one constrained to zero, made
// the solver search a whole 24-round miter (the CI runner ran out of memory).
//
// usage (from this directory): saw <this file>

enable_experimental;
m <- mir_load_module "../../../target/saw-pq02/pq02_harness022.linked-mir.json";

print "PQ02-SAW-TEETH obligation pq02_harness022::agree_swapped returns true on the zero state";
mir_verify m "pq02_harness022::agree_swapped" [] false (do {
  r <- mir_alloc (mir_array 25 mir_u64);
  mir_points_to r (mir_term {{ zero : [25][64] }});
  mir_execute_func [r];
  mir_return (mir_term {{ True }});
}) (w4_unint_bitwuzla []);
print "PQ02-SAW-TEETH UNEXPECTED-PROVEN pq02_harness022::agree_swapped returns true on the zero state";
