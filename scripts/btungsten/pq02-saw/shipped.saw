// SPEC-BTUNGSTEN-PQ-1 PQ02 — the keccak crate's OWN round body against FIPS
// 202, one round at a time. pq02_harness::shipped_round_<k> runs the crate's
// generic keccak::keccak_p once with constant RC[k] (through the harness
// lane type whose operations are u64's own; see harness.rs `Lane`), and is
// proven equal to keccakRound k for every state, for k = 0..23.
//
// What this does not check by machine: that keccak::p1600(s, 24), the u64
// instantiation, is those 24 bodies in order. That is the crate's loop
// (`for &rc in round_consts`, src/lib.rs:248), read, not proven: a direct
// 24-round comparison does not close with any solver here.
//
// usage (from this directory): saw shipped.saw   with MIR at ../../../target/saw-pq02/

enable_experimental;
import "../pq02-cryptol/KeccakF1600.cry";

m <- mir_load_module "../../../target/saw-pq02/pq02_harness.linked-mir.json";

let shipped_spec ir = do {
  st <- mir_fresh_var "st" (mir_array 25 mir_u64);
  r <- mir_alloc_mut (mir_array 25 mir_u64);
  mir_points_to r (mir_term st);
  mir_execute_func [r];
  mir_points_to r (mir_term {{ keccakRound (`ir : Integer) st }});
};

for (eval_list {{ [0 .. 23] : [24][8] }}) (\t -> do {
  let ir = eval_int t;
  let name = str_concat "shipped_round_" (show ir);
  mir_verify m (str_concat "pq02_harness::" name) [] false (shipped_spec ir) (w4_unint_bitwuzla []);
  print (str_concat "PQ02-SAW PROVEN " name);
});
