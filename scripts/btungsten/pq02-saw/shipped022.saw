// SPEC-BTUNGSTEN-PQ-1 PQ02 — keccak 0.2.2 (the Keccak under sha3 0.11, which
// ml-kem 0.3.2 and slh-dsa link), its OWN round body against FIPS 202, one
// round at a time. pq02_harness022::shipped_round_<k> runs the crate's
// backends::soft::keccak_p (compiled verbatim from the checksum-verified
// .crate, see harness022.rs) once with constant RC[k], and is proven equal to
// keccakRound k for every state, for k = 0..23. Then composed (those 24 in
// order) equal to keccakF, and agree: `keccak_p::<u64, 24>`, what sha3
// 0.11's soft backend runs, equal to composed for every state. Together:
// the shipped permutation is Keccak-f[1600] for every state (two proofs
// joined by equality).
//
// usage (from this directory): saw shipped022.saw   with MIR at ../../../target/saw-pq02/

enable_experimental;
import "../pq02-cryptol/KeccakF1600.cry";

m <- mir_load_module "../../../target/saw-pq02/pq02_harness022.linked-mir.json";

let shipped_spec ir = do {
  st <- mir_fresh_var "st" (mir_array 25 mir_u64);
  r <- mir_alloc_mut (mir_array 25 mir_u64);
  mir_points_to r (mir_term st);
  mir_execute_func [r];
  mir_points_to r (mir_term {{ keccakRound (`ir : Integer) st }});
};

ovs <- for (eval_list {{ [0 .. 23] : [24][8] }}) (\t -> do {
  let ir = eval_int t;
  let name = str_concat "shipped_round_" (show ir);
  ov <- mir_verify m (str_concat "pq02_harness022::" name) [] false (shipped_spec ir) (w4_unint_bitwuzla []);
  print (str_concat "PQ02-SAW PROVEN keccak022." name);
  return ov;
});

// The loop: the 24 proofs above stand in for the round calls, and with
// keccakRound held opaque (z3: its index is an Integer) composed is the
// spec's fold. agree (the shipped permutation against composed) is its own
// file, agree*.saw, so its peak memory is not added to these.
let perm_spec post = do {
  st <- mir_fresh_var "st" (mir_array 25 mir_u64);
  r <- mir_alloc_mut (mir_array 25 mir_u64);
  mir_points_to r (mir_term st);
  mir_execute_func [r];
  mir_points_to r (mir_term (post st));
};
mir_verify m "pq02_harness022::composed" ovs false (perm_spec (\st -> {{ keccakF st }})) (w4_unint_z3 ["keccakRound"]);
print "PQ02-SAW PROVEN keccak022.composed";
