// SPEC-BTUNGSTEN-PQ-1 PQ02 — the shipped Keccak-f[1600] against the harness
// reference: pq02_harness::agree(s) runs keccak::p1600(s, 24) (the keccak
// 0.1.6 crate as cargo ships it, under sha3 0.10's SHA3-256 and SHAKE256)
// and pq02_harness::reference(s), and returns true for EVERY state s.
// round.saw proves reference equal to FIPS 202 keccakF, so together the
// shipped permutation is Keccak-f[1600] for all 2^1600 states.
//
// usage (from this directory): saw agree.saw   with MIR at ../../../target/saw-pq02/

enable_experimental;

m <- mir_load_module "../../../target/saw-pq02/pq02_harness.linked-mir.json";

let agree_spec = do {
  st <- mir_fresh_var "st" (mir_array 25 mir_u64);
  r <- mir_alloc (mir_array 25 mir_u64);
  mir_points_to r (mir_term st);
  mir_execute_func [r];
  mir_return (mir_term {{ True }});
};
mir_verify m "pq02_harness::agree" [] false agree_spec (w4_unint_bitwuzla []);
print "PQ02-SAW PROVEN agree";
