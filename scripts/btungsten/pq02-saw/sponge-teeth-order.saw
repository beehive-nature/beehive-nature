// SPEC-BTUNGSTEN-PQ-1 PQ02 — TOOTH for sponge.saw: sha3_256_parts against the
// digest of its two parts in the other order: the proof reads the block
// buffer's join.
// It MUST fail with a counterexample.
//
// usage (from this directory): saw sponge-teeth-order.saw

enable_experimental;
import "../pq02-cryptol/KeccakF1600.cry";

m <- mir_load_module "../../../target/saw-pq02-sponge/pq02_sponge.linked-mir.json";
ov_p <- mir_unsafe_assume_spec m "keccak::p1600" (do {
  st <- mir_fresh_var "st" (mir_array 25 mir_u64);
  r <- mir_alloc_mut (mir_array 25 mir_u64);
  mir_points_to r (mir_term st);
  mir_execute_func [r, mir_term {{ 24 : [64] }}];
  mir_points_to r (mir_term {{ keccakF st }});
});

print "PQ02-SAW-TEETH obligation sha3_256_parts against the parts swapped";
mir_verify m "pq02_sponge::sha3_256_parts" [ov_p] false (do {
  a <- mir_fresh_var "a" (mir_array 8 mir_u8);
  b <- mir_fresh_var "b" (mir_array 192 mir_u8);
  pa <- mir_alloc (mir_array 8 mir_u8);
  mir_points_to pa (mir_term a);
  pb <- mir_alloc (mir_array 192 mir_u8);
  mir_points_to pb (mir_term b);
  mir_execute_func [pa, pb];
  mir_return (mir_term {{ sha3_256 (b # a) }});
}) (w4_unint_bitwuzla ["keccakF"]);
print "PQ02-SAW-TEETH UNEXPECTED-PROVEN sha3_256_parts against the parts swapped";
