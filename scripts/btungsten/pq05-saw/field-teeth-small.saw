// SPEC-BTUNGSTEN-PQ-1 PQ05 — TOOTH unboundedSmall: the conditional
// subtraction claimed to reduce EVERY 16-bit x MUST fail with a
// counterexample (it reduces only x < 2q; the precondition is load-bearing).

enable_experimental;
import "../pq05-cryptol/Field.cry";
m <- mir_load_module "../../../target/saw-pq05-field/pq05_field.linked-mir.json";

print "PQ05-SAW-TEETH obligation unboundedSmall";
mir_verify m "pq05_field::kem_small" [] false (do {
  x <- mir_fresh_var "x" mir_u16;
  mir_execute_func [mir_term x];
  mir_return (mir_term {{ x % 3329 }});
}) (w4_unint_bitwuzla []);
print "PQ05-SAW-TEETH UNEXPECTED-PROVEN unboundedSmall";
