// bTunGsTeN Workbench 001 — the formal twin of wb001-intent.mjs.
//
// STAGED until the CI formal job's receipts land; result classes are
// recorded separately and none implies another (SPEC-BTUNGSTEN-1
// §workbench result-class law): TYPECHECK, CHECK-SAMPLED (:check, with
// CONSTRUCTED related pairs — random sampling alone rarely challenges
// the collision condition), PROVE-UNIVERSAL (:prove, budgeted attempt,
// timeout = NOT-PROVEN, never success), EQUIVALENCE (SAW, not attempted
// here — the shared vectors establish sampled agreement, not universal
// equivalence).
//
// BEAT 3 (founder ruling 2026-10-07): the accepted language is now
// CONCRETE in the model. wellFormedUtf8 is a real DFA with exactly the
// transition law of the runtime validator (wb001-intent.mjs
// assertValidUtf8) — the same class-checking, overlong/surrogate/
// >U+10FFFF/truncation refusals — because "universal wireInjective is
// only as meaningful as the validity predicate": a proof can be correct
// about the WRONG accepted language, the exact class of mistake Beat 2
// eliminated. The runtime validator's agreement with this DFA is
// sampled by the shared vectors today and belongs to the future
// EQUIVALENCE class; it is never claimed from the samples.
//
// Wire format mirrored exactly: envelope = "bT-WB01" || 0x01 || tlv*;
// tlv = tag(1) || length(4, BE u32) || value, `length` counts MEANINGFUL
// bytes; ten fields, tags strictly ascending 0x01..0x0a, nothing
// trailing. The deployed envelope is the first envLen bytes of `wire`.

module BTungstenWB001 where

type Byte = [8]

type Field cap = { len : [32], bytes : [cap][8] }

type Intent =
  { domain       : Field 64
  , nonce        : Field 32
  , epoch        : [64]
  , action       : Field 32
  , destination  : Field 128
  , capability   : Field 64
  , amount       : [64]
  , expiry       : [64]
  , payer        : Field 128
  , payload      : Field 4096
  }

L8 : [32]
L8 = 8
L32 : [32]
L32 = 32

//////////////////////////////////////////////////////////////////////////////
// THE CONCRETE ACCEPTED LANGUAGE — the UTF-8 DFA
//
// States: ground (complete sequence), Ck (k plain continuations still
// expected), and the four lead-specific first-continuation ranges that
// forbid overlong forms, encoded surrogates and > U+10FFFF. BAD absorbs.
// The scan runs over the whole capacity array; this is exactly prefix
// validity because ground is a fixed point for the canonical zero
// padding (a zero byte is a valid ASCII lead), and a TRUNCATED prefix
// leaves the DFA mid-sequence where the padding cannot rescue it — the
// truncation refuses, as it must.
//////////////////////////////////////////////////////////////////////////////

stG, stC1, stC2, stC3, stE0, stED, stF0, stF4, sBAD : [4]
stG = 0
stC1 = 1
stC2 = 2
stC3 = 3
stE0 = 4
stED = 5
stF0 = 6
stF4 = 7
sBAD = 13

step : [4] -> Byte -> [4]
step st b =
  if st == sBAD then sBAD else
  if st == stG then
       if b <= 0x7f                                        then stG
  else if (b >= 0xc2) && (b <= 0xdf)                           then stC1
  else if b == 0xe0                                        then stE0
  else if ((b >= 0xe1) && (b <= 0xec)) || (b == 0xee) || (b == 0xef) then stC2
  else if b == 0xed                                        then stED
  else if b == 0xf0                                        then stF0
  else if (b >= 0xf1) && (b <= 0xf3)                           then stC3
  else if b == 0xf4                                        then stF4
  else sBAD
  else if st == stC1 then (if (b >= 0x80) && (b <= 0xbf) then stG  else sBAD)
  else if st == stC2 then (if (b >= 0x80) && (b <= 0xbf) then stC1 else sBAD)
  else if st == stC3 then (if (b >= 0x80) && (b <= 0xbf) then stC2 else sBAD)
  else if st == stE0 then (if (b >= 0xa0) && (b <= 0xbf) then stC1 else sBAD)
  else if st == stED then (if (b >= 0x80) && (b <= 0x9f) then stC1 else sBAD)
  else if st == stF0 then (if (b >= 0x90) && (b <= 0xbf) then stC2 else sBAD)
  else if st == stF4 then (if (b >= 0x80) && (b <= 0x8f) then stC2 else sBAD)
  else sBAD

// Lazy positional self-reference: state(i) consumes byte i from
// state(i-1). (TYPECHECK iterations so far: no where-semicolon, no
// let-expression — Cryptol 3 takes neither; if the termination checker
// still rejects the self-reference, the value-driven head/tail recursion
// is the fallback. The SEMANTICS are fixed by this equation either way.)
scan : {cap} (fin cap) => [4] -> [cap]Byte -> [cap][4]
scan st0 bs =
  [ step (if i == 0 then st0 else (scan st0 bs) @ (i - 1)) (bs @ i)
  | i <- take`{cap} [0 ...]
  ]

wellFormedUtf8 : {cap} (fin cap) => Field cap -> Bit
wellFormedUtf8 f = ((scan stG f.bytes) @ (`(cap) - 1)) == stG

//////////////////////////////////////////////////////////////////////////////
// Valid intents: bounds per field, fixed legal length words for the
// fixed-width fields, canonical zero padding, and the concrete UTF-8 law
// on every text field.
//////////////////////////////////////////////////////////////////////////////

canonicalPad : {cap} (fin cap) => [32] -> [cap][8] -> [cap][8]
canonicalPad len bs =
  [ if i < len then bs @ i else 0 | i <- take`{cap} [0 ...] ]

validField : {cap} (fin cap) => [32] -> [32] -> Field cap -> Bit
validField lo hi f = (f.len >= lo) && (f.len <= hi) && (canonicalPad f.len f.bytes == f.bytes)

validIntent : Intent -> Bit
validIntent i =
       validField 1 64  i.domain    && wellFormedUtf8 i.domain
    && (i.nonce.len == L32)           && (canonicalPad i.nonce.len i.nonce.bytes == i.nonce.bytes)
    && (i.action.len == L32)          && (canonicalPad i.action.len i.action.bytes == i.action.bytes)
    && validField 1 128 i.destination && wellFormedUtf8 i.destination
    && validField 1 64  i.capability   && wellFormedUtf8 i.capability
    && validField 1 128 i.payer       && wellFormedUtf8 i.payer
    && validField 0 4096 i.payload

//////////////////////////////////////////////////////////////////////////////
// The wire: exactly the deployed bytes on the meaningful prefix, zero
// padding beyond it (canonicalPad + validIntent guarantee nothing
// meaningful hides in the padding).
//////////////////////////////////////////////////////////////////////////////

wireTlv : {cap} (fin cap) => Byte -> Field cap -> [5 + cap][8]
wireTlv t f = [t] # split f.len # f.bytes

u64 : [64] -> Field 8
u64 w = { len = L8, bytes = split w }

type MaxEnv = 7 + 1 + (5+64) + (5+32) + (5+8) + (5+32) + (5+128) + (5+64) + (5+8) + (5+8) + (5+128) + (5+4096)

wire : Intent -> [MaxEnv][8]
wire i =
  "bT-WB01" # [0x01]
    # wireTlv 0x01 i.domain
    # wireTlv 0x02 i.nonce
    # wireTlv 0x03 (u64 i.epoch)
    # wireTlv 0x04 i.action
    # wireTlv 0x05 i.destination
    # wireTlv 0x06 i.capability
    # wireTlv 0x07 (u64 i.amount)
    # wireTlv 0x08 (u64 i.expiry)
    # wireTlv 0x09 i.payer
    # wireTlv 0x0a i.payload

envLen : Intent -> [32]
envLen i = 8 + (5 + i.domain.len) + (5 + i.nonce.len) + (5 + L8) + (5 + i.action.len)
             + (5 + i.destination.len) + (5 + i.capability.len) + (5 + L8) + (5 + L8)
             + (5 + i.payer.len) + (5 + i.payload.len)

// The signature scheme is an ASSUMED-CORRECT primitive (Ed25519 in the
// implementation) within the published adversarial model; the workbench
// owns the layer under the assumption — that the signed message is
// exactly the committed intent's canonical bytes. The assumption lives
// in prose here, not as a declaration: Cryptol requires every signature
// to carry a binding, and an abstract SigVerify had none (typecheck
// round 4). P3's formal statement — verification is over the wire bytes
// of the intent under test and nothing else — is exactly wireInjective's
// premise once the primitive is assumed, so no obligation is lost.

//////////////////////////////////////////////////////////////////////////////
// P2 — THE framing property, for all VALID pairs:
//////////////////////////////////////////////////////////////////////////////

wireInjective : Intent -> Intent -> Bit
property wireInjective a b =
  (validIntent a && validIntent b && (wire a == wire b)) ==> (a == b)

//////////////////////////////////////////////////////////////////////////////
// CHECK-SAMPLED, constructed arm (closed terms — evaluated exactly, not
// sampled): valid international text is ACCEPTED (astral, a legitimate
// U+FFFD, combining sequences), boundary-shift twins and near-collision
// payload pairs stay DISTINCT on the wire.
//////////////////////////////////////////////////////////////////////////////

mkB : {m, cap} (fin m, fin cap) => [m][8] -> [32] -> Field cap
mkB b n = { len = n, bytes = take`{cap} (b # (zero : [cap][8])) }

bee : [4]Byte
bee = split (0xf09f909d : [32])   // 🐝 — a valid 4-byte supplementary char

iBase : Intent
iBase =
  { domain      = mkB "skaists.bpay/1" 14
  , nonce       = mkB ("nonce-wb001" # (zero : [32][8])) L32
  , epoch       = 1
  , action      = mkB ("action-hash-01" # (zero : [32][8])) L32
  , destination = mkB "vault:0xBEEF" 12
  , capability  = mkB "pay" 3
  , amount      = 1000000
  , expiry      = 1790000000
  , payer       = mkB "seat:bFUzZ" 10
  , payload     = mkB "{}" 2
  }

twinL : Intent
twinL =
  { domain      = mkB "skaists.bpay/1" 14
  , nonce       = mkB ("nonce-wb001" # (zero : [32][8])) L32
  , epoch       = 1
  , action      = mkB ("action-hash-01" # (zero : [32][8])) L32
  , destination = mkB "ab" 2
  , capability  = mkB "c" 1
  , amount      = 1000000
  , expiry      = 1790000000
  , payer       = mkB "seat:bFUzZ" 10
  , payload     = mkB "{}" 2
  }
twinR : Intent
twinR =
  { domain      = mkB "skaists.bpay/1" 14
  , nonce       = mkB ("nonce-wb001" # (zero : [32][8])) L32
  , epoch       = 1
  , action      = mkB ("action-hash-01" # (zero : [32][8])) L32
  , destination = mkB "a" 1
  , capability  = mkB "bc" 2
  , amount      = 1000000
  , expiry      = 1790000000
  , payer       = mkB "seat:bFUzZ" 10
  , payload     = mkB "{}" 2
  }

astral : Intent
astral =
  { domain      = mkB ("skaists." # bee # "/1") 14
  , nonce       = mkB ("nonce-wb001" # (zero : [32][8])) L32
  , epoch       = 1
  , action      = mkB ("action-hash-01" # (zero : [32][8])) L32
  , destination = mkB "vault:0xBEEF" 12
  , capability  = mkB "pay" 3
  , amount      = 1000000
  , expiry      = 1790000000
  , payer       = mkB "seat:bFUzZ" 10
  , payload     = mkB "{}" 2
  }

fffd : Intent
fffd =
  { domain      = mkB "skaists.bpay/1" 14
  , nonce       = mkB ("nonce-wb001" # (zero : [32][8])) L32
  , epoch       = 1
  , action      = mkB ("action-hash-01" # (zero : [32][8])) L32
  , destination = mkB "vault:0xBEEF" 12
  , capability  = mkB "pay" 3
  , amount      = 1000000
  , expiry      = 1790000000
  , payer       = mkB (split (0xefbfbd : [24])) 3
  , payload     = mkB "{}" 2
  }

combining : Intent
combining =
  { domain      = mkB "skaists.bpay/1" 14
  , nonce       = mkB ("nonce-wb001" # (zero : [32][8])) L32
  , epoch       = 1
  , action      = mkB ("action-hash-01" # (zero : [32][8])) L32
  , destination = mkB ("e" # split (0xcc81 : [16])) 3
  , capability  = mkB "pay" 3
  , amount      = 1000000
  , expiry      = 1790000000
  , payer       = mkB "seat:bFUzZ" 10
  , payload     = mkB "{}" 2
  }

nearA : Intent
nearA =
  { domain      = mkB "skaists.bpay/1" 14
  , nonce       = mkB ("nonce-wb001" # (zero : [32][8])) L32
  , epoch       = 1
  , action      = mkB ("action-hash-01" # (zero : [32][8])) L32
  , destination = mkB "vault:0xBEEF" 12
  , capability  = mkB "pay" 3
  , amount      = 1000000
  , expiry      = 1790000000
  , payer       = mkB "seat:bFUzZ" 10
  , payload     = mkB (split (0xdeadbeef : [32])) 4
  }
nearB : Intent
nearB =
  { domain      = mkB "skaists.bpay/1" 14
  , nonce       = mkB ("nonce-wb001" # (zero : [32][8])) L32
  , epoch       = 1
  , action      = mkB ("action-hash-01" # (zero : [32][8])) L32
  , destination = mkB "vault:0xBEEF" 12
  , capability  = mkB "pay" 3
  , amount      = 1000000
  , expiry      = 1790000000
  , payer       = mkB "seat:bFUzZ" 10
  , payload     = mkB (split (0xdeadbeef : [32]) # [0x00]) 5
  }

// Constructed arm, one obligation per claim (the founder ruling asks for
// exact obligation names; a conjunction hid which claim red on the first
// green-ladder run — this split makes CI name it). The per-field rows
// exist because validIBase red while the adversarial arm passed — if a
// conjunct is constant-false the adversarial arm cannot see it; these can.
validDomain_iBase : Bit
property validDomain_iBase =
  (validField 1 64 iBase.domain) && (wellFormedUtf8 iBase.domain)

validNonce_iBase : Bit
property validNonce_iBase =
  (iBase.nonce.len == L32) && (canonicalPad iBase.nonce.len iBase.nonce.bytes == iBase.nonce.bytes)

validAction_iBase : Bit
property validAction_iBase =
  (iBase.action.len == L32) && (canonicalPad iBase.action.len iBase.action.bytes == iBase.action.bytes)

validDest_iBase : Bit
property validDest_iBase =
  (validField 1 128 iBase.destination) && (wellFormedUtf8 iBase.destination)

validCap_iBase : Bit
property validCap_iBase =
  (validField 1 64 iBase.capability) && (wellFormedUtf8 iBase.capability)

validPayer_iBase : Bit
property validPayer_iBase =
  (validField 1 128 iBase.payer) && (wellFormedUtf8 iBase.payer)

validPayload_iBase : Bit
property validPayload_iBase = validField 0 4096 iBase.payload

validIBase : Bit
property validIBase = validIntent iBase

twinsValid : Bit
property twinsValid = (validIntent twinL) && (validIntent twinR)

twinsDistinct : Bit
property twinsDistinct = (wire twinL != wire twinR)

validAstral : Bit
property validAstral = validIntent astral

validFffd : Bit
property validFffd = validIntent fffd

validCombining : Bit
property validCombining = validIntent combining

nearValid : Bit
property nearValid = (validIntent nearA) && (validIntent nearB)

nearDistinct : Bit
property nearDistinct = (wire nearA != wire nearB)

baseVsTwinDistinct : Bit
property baseVsTwinDistinct = (wire iBase != wire twinL)

//////////////////////////////////////////////////////////////////////////////
// CHECK-SAMPLED, adversarial arm (closed terms): intents OUTSIDE
// validIntent — every malformed-UTF-8 class the runtime validator
// refuses, plus bounds and canonical-padding violations — are REJECTED
// by the model BEFORE any injectivity claim is evaluated against them.
//////////////////////////////////////////////////////////////////////////////

xSurrogate : Intent   // ed a0 80 — a UTF-16 surrogate encoded on the wire (CESU-8)
xSurrogate =
  { domain      = mkB ("skaists." # split (0xeda080 : [24])) 11
  , nonce       = mkB ("nonce-wb001" # (zero : [32][8])) L32
  , epoch       = 1
  , action      = mkB ("action-hash-01" # (zero : [32][8])) L32
  , destination = mkB "vault:0xBEEF" 12
  , capability  = mkB "pay" 3
  , amount      = 1000000
  , expiry      = 1790000000
  , payer       = mkB "seat:bFUzZ" 10
  , payload     = mkB "{}" 2
  }

xOverlong : Intent    // c0 80 — overlong ASCII
xOverlong =
  { domain      = mkB ("a" # split (0xc080 : [16])) 3
  , nonce       = mkB ("nonce-wb001" # (zero : [32][8])) L32
  , epoch       = 1
  , action      = mkB ("action-hash-01" # (zero : [32][8])) L32
  , destination = mkB "vault:0xBEEF" 12
  , capability  = mkB "pay" 3
  , amount      = 1000000
  , expiry      = 1790000000
  , payer       = mkB "seat:bFUzZ" 10
  , payload     = mkB "{}" 2
  }

xRawFF : Intent       // ff — not a lead byte at all
xRawFF =
  { domain      = mkB [0xff] 1
  , nonce       = mkB ("nonce-wb001" # (zero : [32][8])) L32
  , epoch       = 1
  , action      = mkB ("action-hash-01" # (zero : [32][8])) L32
  , destination = mkB "vault:0xBEEF" 12
  , capability  = mkB "pay" 3
  , amount      = 1000000
  , expiry      = 1790000000
  , payer       = mkB "seat:bFUzZ" 10
  , payload     = mkB "{}" 2
  }

xBeyond : Intent      // f4 90 80 80 — beyond U+10FFFF
xBeyond =
  { domain      = mkB (split (0xf4908080 : [32])) 4
  , nonce       = mkB ("nonce-wb001" # (zero : [32][8])) L32
  , epoch       = 1
  , action      = mkB ("action-hash-01" # (zero : [32][8])) L32
  , destination = mkB "vault:0xBEEF" 12
  , capability  = mkB "pay" 3
  , amount      = 1000000
  , expiry      = 1790000000
  , payer       = mkB "seat:bFUzZ" 10
  , payload     = mkB "{}" 2
  }

xTrunc : Intent       // a c2 — sequence truncated by the field's length
xTrunc =
  { domain      = mkB ("a" # [0xc2]) 2
  , nonce       = mkB ("nonce-wb001" # (zero : [32][8])) L32
  , epoch       = 1
  , action      = mkB ("action-hash-01" # (zero : [32][8])) L32
  , destination = mkB "vault:0xBEEF" 12
  , capability  = mkB "pay" 3
  , amount      = 1000000
  , expiry      = 1790000000
  , payer       = mkB "seat:bFUzZ" 10
  , payload     = mkB "{}" 2
  }

xLenBeyondCap : Intent // length word outside the field's capacity — bounds violation
xLenBeyondCap =
  { domain      = { len = 65, bytes = (mkB "ab" 2 : Field 64).bytes }
  , nonce       = mkB ("nonce-wb001" # (zero : [32][8])) L32
  , epoch       = 1
  , action      = mkB ("action-hash-01" # (zero : [32][8])) L32
  , destination = mkB "vault:0xBEEF" 12
  , capability  = mkB "pay" 3
  , amount      = 1000000
  , expiry      = 1790000000
  , payer       = mkB "seat:bFUzZ" 10
  , payload     = mkB "{}" 2
  }

xNonCanonPad : Intent // meaningful beyond len — padding not canonical
xNonCanonPad =
  { domain      = { len = 1, bytes = (mkB "ab" 2 : Field 64).bytes }
  , nonce       = mkB ("nonce-wb001" # (zero : [32][8])) L32
  , epoch       = 1
  , action      = mkB ("action-hash-01" # (zero : [32][8])) L32
  , destination = mkB "vault:0xBEEF" 12
  , capability  = mkB "pay" 3
  , amount      = 1000000
  , expiry      = 1790000000
  , payer       = mkB "seat:bFUzZ" 10
  , payload     = mkB "{}" 2
  }

adversarialRejected : Bit
property adversarialRejected =
    and [ validIntent x == False | x <- [ xSurrogate, xOverlong, xRawFF, xBeyond, xTrunc, xLenBeyondCap, xNonCanonPad ] ]

//////////////////////////////////////////////////////////////////////////////
// BRIDGE (model <-> deployed bytes) — EXECUTABLE (founder review B1,
// 2026-10-07): the block below was comment-only until B1; no Cryptol
// wire byte had ever been compared to a runtime canonical() byte, so
// the universal wireInjective proof was about the model's wire with
// the deployed-envelope claim resting on prose. Repair: the runtime
// bytes of every constructed term are pinned here as OPAQUE constants
// (derived by scripts/btungsten/wb001-bridge-gen.mjs from
// wb001-intent.mjs canonical(); pinned in wb001-bridge.json; never
// hand-written), and two independent CI legs re-derive them every run:
//   node leg   (wb001-bridge.test.mjs): canonical() == JSON bytes, and
//              this file carries each envelope hex literal verbatim;
//   formal leg (wb001-formal-check.sh): :check evaluates each bridge
//              property below — exact prefix, exact zero tail, and the
//              envLen arithmetic — as closed terms, exactly.
// Any drift on either side goes red. This is sampled agreement on
// pinned terms, never universal equivalence (result-class law); the
// deployed-wire proof claim closes on these receipts, not on prose.
//////////////////////////////////////////////////////////////////////////////

// ---- pinned runtime bytes (generated by wb001-bridge-gen.mjs; re-derived every CI run on BOTH legs) ----
biBase : [187][8]
biBase =   // PUBLIC-CONSTANT: runtime canonical() envelope of iBase
btwinL : [175][8]
btwinL =   // PUBLIC-CONSTANT: runtime canonical() envelope of twinL
btwinR : [175][8]
btwinR =   // PUBLIC-CONSTANT: runtime canonical() envelope of twinR
bastral : [187][8]
bastral =   // PUBLIC-CONSTANT: runtime canonical() envelope of astral
bfffd : [180][8]
bfffd =   // PUBLIC-CONSTANT: runtime canonical() envelope of fffd
bcombining : [178][8]
bcombining =   // PUBLIC-CONSTANT: runtime canonical() envelope of combining
bnearA : [189][8]
bnearA =   // PUBLIC-CONSTANT: runtime canonical() envelope of nearA
bnearB : [190][8]
bnearB =   // PUBLIC-CONSTANT: runtime canonical() envelope of nearB

// prefix + zero tail + envLen arithmetic, one obligation per term (a
// red names its term). tail widths are MaxEnv - envLen, spelled out so
// the concatenation forces the full padded-wire width.
bridgeIBase : Bit
property bridgeIBase =
  (wire iBase == biBase # (zero : [4439][8])) && (envLen iBase == 187)

bridgeTwinL : Bit
property bridgeTwinL =
  (wire twinL == btwinL # (zero : [4451][8])) && (envLen twinL == 175)

bridgeTwinR : Bit
property bridgeTwinR =
  (wire twinR == btwinR # (zero : [4451][8])) && (envLen twinR == 175)

bridgeAstral : Bit
property bridgeAstral =
  (wire astral == bastral # (zero : [4439][8])) && (envLen astral == 187)

bridgeFffd : Bit
property bridgeFffd =
  (wire fffd == bfffd # (zero : [4446][8])) && (envLen fffd == 180)

bridgeCombining : Bit
property bridgeCombining =
  (wire combining == bcombining # (zero : [4448][8])) && (envLen combining == 178)

bridgeNearA : Bit
property bridgeNearA =
  (wire nearA == bnearA # (zero : [4437][8])) && (envLen nearA == 189)

bridgeNearB : Bit
property bridgeNearB =
  (wire nearB == bnearB # (zero : [4436][8])) && (envLen nearB == 190)
