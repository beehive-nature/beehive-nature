     /// budget this node just normalized. That is an x0x/sg contract
     /// disagreement, not operator error, so it must fail loudly rather than
     /// leave the daemon running with silently absent accounting.
+    /// E1 (BTMD Track E experiment): add a VERIFIED store's topics to the
+    /// Leaf egress reserved scope-set. Called ONLY from the KV store
+    /// open/join funnel — the daemon's own verified registry, never a
+    /// topic label and never a wire claim. Both the store's base topic
+    /// and its `/state-sync` side channel are reserved.
+    pub fn add_reserved_store_topic(&self, topic: &str) {
+        use saorsa_gossip_types::TopicId;
+        let mut scopes = std::collections::BTreeSet::new();
+        scopes.insert(*TopicId::from_entity(topic.as_bytes()).as_bytes());
+        scopes.insert(
+            *TopicId::from_entity(format!("{topic}/state-sync").as_bytes()).as_bytes(),
+        );
+        // Merge into any existing set (add-only for the process lifetime;
+        // the set resets on restart, which the store-open funnel rebuilds).
+        self.plumtree.add_leaf_reserved_scopes(scopes);
+    }
+
