+// ---------------------------------------------------------------------------
+// E1 — BTMD Track E experiment: bounded reserved capacity for VERIFIED
+// joined-store sync scopes (BT-MESH-DEPENDABILITY-001, founder order
+// 2026-10-13). Invariants under test, each one an order constraint:
+//   * split OFF is byte-identical legacy behavior (reserved counters zero);
+//   * reserved scopes charge the reservation, with controlled borrowing
+//     above one-second floors in BOTH directions;
+//   * per-peer admission caps stop any single peer monopolizing the
+//     reservation (capped peers get ordinary treatment, not silence);
+//   * backpressure defers reserved sends when neither bucket can serve
+//     them above the floors — never an unlimited bypass;
+//   * total admission never exceeds the single-bucket hard budget.
+// ---------------------------------------------------------------------------
+
+fn e1_limiter(hard: u64, burst: u64, share: u16) -> Arc<LeafEgressLimiter> {
+    let limiter = Arc::new(LeafEgressLimiter::disabled());
+    assert!(limiter.configure(Some(LeafEgressConfig {
+        soft_bytes_per_second: 0,
+        hard_bytes_per_second: hard,
+        burst_bytes: burst,
+        max_serialized_frame_bytes: usize::try_from(burst).unwrap_or(usize::MAX),
+        policy: BytePolicy::ShedNormal,
+        reserved_share_permille: share,
+        reserved_peer_permille: 500,
+    })));
+    limiter
+}
+
+fn data_key(peer: u64, scope: [u8; 32]) -> RecoveryIntentKey {
+    let mut identity = [0_u8; 32];
+    identity[..8].copy_from_slice(&peer.to_le_bytes());
+    RecoveryIntentKey {
+        peer: identity,
+        scope,
+        family: identity,
+        operation: identity,
+    }
+}
+
+#[test]
+fn e1_split_off_keeps_reserved_counters_zero() {
+    let limiter = e1_limiter(1024, 4096, 0);
+    limiter.set_reserved_scopes(BTreeSet::from([[7_u8; 32]]));
+    let now = Instant::now();
+    assert!(limiter
+        .try_reserve_data_at(data_key(1, [7_u8; 32]), 256, true, now)
+        .is_ok());
+    let snapshot = limiter.snapshot();
+    assert_eq!(snapshot.reserved_charged_bytes, 0);
+    assert_eq!(snapshot.reserved_msgs, 0);
+    assert_eq!(snapshot.reserved_deferred, 0);
+    assert_eq!(snapshot.reserved_tokens, 0);
+}
+
+#[test]
+fn e1_reserved_scope_charges_the_reservation() {
+    let limiter = e1_limiter(4000, 4000, 250);
+    let scope = [7_u8; 32];
+    limiter.set_reserved_scopes(BTreeSet::from([scope]));
+    let now = Instant::now();
+    assert!(limiter
+        .try_reserve_data_at(data_key(1, scope), 500, true, now)
+        .is_ok());
+    let snapshot = limiter.snapshot();
+    assert_eq!(snapshot.reserved_charged_bytes, 500);
+    assert_eq!(snapshot.reserved_msgs, 1);
+    assert_eq!(snapshot.reserved_tokens, 1000 - 500);
+}
+
+#[test]
+fn e1_reserved_send_defers_when_both_buckets_are_floored() {
+    let limiter = e1_limiter(4000, 4000, 250);
+    let scope = [7_u8; 32];
+    limiter.set_reserved_scopes(BTreeSet::from([scope]));
+    let now = Instant::now();
+    // Reserved burst = 1000 bytes; the general bucket holds 3000 but its
+    // one-second floor is 3000 — no borrow, and the reservation empties
+    // after two 500-byte sends. The third send defers: backpressure, not
+    // an unlimited bypass.
+    assert!(limiter
+        .try_reserve_data_at(data_key(1, scope), 500, true, now)
+        .is_ok());
+    assert!(limiter
+        .try_reserve_data_at(data_key(2, scope), 500, true, now)
+        .is_ok());
+    assert!(matches!(
+        limiter.try_reserve_data_at(data_key(3, scope), 500, true, now),
+        Err(ReserveError::Deferred)
+    ));
+    assert_eq!(limiter.snapshot().reserved_deferred, 1);
+    // After one second the reservation refills 1000 bytes and serves it.
+    assert!(limiter
+        .try_reserve_data_at(data_key(3, scope), 500, true, now + Duration::from_secs(1))
+        .is_ok());
+}
+
+#[test]
+fn e1_peer_cap_gives_ordinary_treatment_not_silence() {
+    let limiter = e1_limiter(4000, 4000, 250);
+    let scope = [7_u8; 32];
+    limiter.set_reserved_scopes(BTreeSet::from([scope]));
+    let now = Instant::now();
+    // Peer 1's per-second share of the reservation is 500 bytes (peer
+    // permille 500 of the 1000-byte reserved rate). A 600-byte reserved
+    // demand exceeds the peer's allowance — capped, and served from the
+    // general bucket instead (ordinary treatment succeeds: the general
+    // bucket is full). No silence, no monopoly.
+    assert!(limiter
+        .try_reserve_data_at(data_key(1, scope), 600, true, now)
+        .is_ok());
+    let snapshot = limiter.snapshot();
+    assert_eq!(snapshot.reserved_peer_capped, 1);
+    assert_eq!(snapshot.reserved_charged_bytes, 0);
+    assert_eq!(snapshot.charged_bytes, 600);
+}
+
+#[test]
+fn e1_ordinary_borrow_respects_the_reserved_floor() {
+    let limiter = e1_limiter(4000, 4000, 250);
+    let scope = [7_u8; 32];
+    limiter.set_reserved_scopes(BTreeSet::from([scope]));
+    let now = Instant::now();
+    // The general bucket starts at 3000 with the legacy recovery escrow
+    // (25% of burst = 1000) still enforced for ordinary traffic: the
+    // first four 500-byte ordinary sends fit (2000 consumed, 1000 left =
+    // exactly the escrow floor).
+    for index in 0..4 {
+        assert!(limiter
+            .try_reserve_data_at(data_key(100 + index, [9_u8; 32]), 500, false, now)
+            .is_ok());
+    }
+    // The next ordinary send hits the escrow floor and tries to borrow
+    // from the reservation — whose entire balance is its floor (1000
+    // reserved, floor 1000 -> zero above floor): deferred. The floor is
+    // exactly the protection the reservation exists to give.
+    assert!(matches!(
+        limiter.try_reserve_data_at(data_key(200, [9_u8; 32]), 500, false, now),
+        Err(ReserveError::Deferred)
+    ));
+    // A RESERVED send still serves from its floored bucket.
+    assert!(limiter
+        .try_reserve_data_at(data_key(1, scope), 500, true, now)
+        .is_ok());
+}
+
+#[test]
+fn e1_total_admission_never_exceeds_the_single_bucket_budget() {
+    let limiter = e1_limiter(4000, 4000, 250);
+    let scope = [7_u8; 32];
+    limiter.set_reserved_scopes(BTreeSet::from([scope]));
+    let start = Instant::now();
+    let mut admitted = 0_u64;
+    let mut deferred = 0_u64;
+    let mut peer = 0_u64;
+    for second in 0..4_u64 {
+        for _ in 0..40 {
+            peer += 1;
+            let key = if peer % 2 == 0 {
+                data_key(peer, scope)
+            } else {
+                data_key(peer, [9_u8; 32])
+            };
+            match limiter.try_reserve_data_at(key, 500, false, start + Duration::from_secs(second)) {
+                Ok(_) => admitted += 500,
+                Err(ReserveError::Deferred) => deferred += 1,
+                Err(other) => panic!("unexpected {other:?}"),
+            }
+        }
+    }
+    // Hard budget: 4000 burst + 4 seconds x 4000/s = 20000. The split
+    // must never admit more than that.
+    assert!(
+        admitted <= 20_000,
+        "admitted {admitted} exceeds the single-bucket budget"
+    );
+    assert!(deferred > 0, "the workload must actually saturate");
+}
