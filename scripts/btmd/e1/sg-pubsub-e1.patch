+        let scope_reserved = self
+            .reserved_scopes
+            .read()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .contains(&key.scope);
+        let soft_charge = |state: &mut State| {
+            if relayed && config.soft_bytes_per_second > 0 {
+                state.soft_tokens = state.soft_tokens.saturating_sub(bytes);
+            }
+        };
