+    /// E1 per-peer admission: lazily refilled allowance into the
+    /// reservation, capped at one second of this peer's share of the
+    /// reserved rate. Returns whether `bytes` may enter the reservation
+    /// from this peer right now, and consumes the allowance when true.
+    fn e1_peer_admitted(
+        &self,
+        state: &mut State,
+        config: &LeafEgressConfig,
+        peer: [u8; 32],
+        bytes: u64,
+    ) -> bool {
+        if config.reserved_peer_permille == 0 {
+            return true;
+        }
+        let now = Self::now_of(state);
+        let peer_rate =
+            u64::from(config.reserved_peer_permille) * config.reserved_rate() / 1000;
+        // Bound the map BEFORE borrowing an entry: over the cap, drop the
+        // map (other peers re-accrue from zero — conservative) and start
+        // this peer fresh at a full one-second share.
+        if state.reserved_peer_allowance.len() > E1_MAX_PEER_ROWS {
+            state.reserved_peer_allowance.clear();
+            state.reserved_peer_allowance.insert(peer, (peer_rate, now));
+            return peer_rate >= bytes;
+        }
+        let entry = state
+            .reserved_peer_allowance
+            .entry(peer)
+            .or_insert((peer_rate, now));
+        let elapsed = now.saturating_duration_since(entry.1);
+        if elapsed > Duration::ZERO {
+            entry.0 = (entry.0.saturating_add(
+                u64::try_from(elapsed.as_nanos() * u128::from(peer_rate) / 1_000_000_000)
+                    .unwrap_or(u64::MAX),
+            ))
+            .min(peer_rate);
+            entry.1 = now;
+        }
+        let admitted = entry.0 >= bytes;
+        if admitted {
+            entry.0 -= bytes;
+        }
+        admitted
+    }
