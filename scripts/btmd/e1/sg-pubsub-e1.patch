+                state.tokens -= bytes;
+                soft_charge(&mut state);
+                self.counters
+                    .reserved_borrowed_bytes
+                    .fetch_add(bytes, Ordering::Relaxed);
+                self.counters.reserved_msgs.fetch_add(1, Ordering::Relaxed);
+                self.counters
+                    .charged_bytes
+                    .fetch_add(bytes, Ordering::Relaxed);
+                return Ok(ByteReservation { key, generation });
+            }
+            self.counters.reserved_deferred.fetch_add(1, Ordering::Relaxed);
+            self.counters.data_deferred.fetch_add(1, Ordering::Relaxed);
