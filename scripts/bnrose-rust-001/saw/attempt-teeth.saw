// BNROSE-SAW-001 — the attempt tooth: a MUTATED spec (the saturation
// corner dropped: at 15 the tooth claims 0 instead of 15) MUST make the
// proof FAIL with a counterexample at m = 15. This script is expected to
// exit NONZERO; saw-check.sh requires exactly that.

enable_experimental;
import "../cryptol/BnroseReplacement.cry";

m <- mir_load_module "../../../target/saw-bnrose/bnrose_replacement_law.linked-mir.json";

let attempt_tooth = do {
  mv <- mir_fresh_var "m" mir_u8;
  mir_execute_func [mir_term mv];
  mir_return (mir_term {{ if mv == (15 : [8]) then (0 : [8]) else attempt8 mv }});
};

mir_verify m "bnrose_saw_harness::saw_attempt" [] false attempt_tooth (w4_unint_yices []);
print "BNROSE-SAW TOOTH UNCAUGHT — the mutated spec verified; RED";
